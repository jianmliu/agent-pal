      "retrieved": "2026-10-08",
      "note": "paid tier, page last updated 2026-10-07; rates valid through 2026-12-31 (many rise on 2027-01-01); output includes thinking tokens; gemini-3.1-pro-preview is the <=200K-prompt tier; cacheRead = context-caching price for text input (storage not charged here)"
    },
    "laya": {
      "url": "https://huggingface.co/convaiinnovations/laya-multilingual",
      "retrieved": "2026-10-22",
      "note": "open-weights local inference ($0 API cost)"
    }
