      "note": "first-party API rates; claude-haiku-5-5 is $0.10/$0.50 for prompts up to 100K tokens ($0.50/$2.50 beyond); cacheRead = cache hits, cacheWrite = 5-minute cache writes"
    },
    "openai": {
      "url": "https://developers.openai.com/api/docs/pricing",
      "retrieved": "2026-10-08",
