{
  "name": "@onchainpal/game-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "2D PAL client engine (ESM/TS).",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./js/pal/surface": {
      "import": "./dist/js/pal/surface.js"
    },
    "./js/pal/ui": {
      "import": "./dist/js/pal/ui.js"
    },
    "./services/input-service": {
      "import": "./dist/services/input-service.js"
    },
    "./services/dialog-service": {
      "import": "./dist/services/dialog-service.js"
    },
    "./js/pal/panorama-renderer": {
      "import": "./dist/js/pal/panorama-renderer.js"
    },
    "./services/scene-service": {
      "import": "./dist/services/scene-service.js"
    },
    "./js/pal/palette": {
      "import": "./dist/js/pal/palette.js"
    },
    "./services/world-service": {
      "import": "./dist/services/world-service.js"
    },
    "./js/pal/play": {
      "import": "./dist/js/pal/play.js"
    },
    "./services/index": {
      "import": "./dist/services/index.js"
    },
    "./ai/ai-gateway": {
      "import": "./dist/ai/ai-gateway.js"
    },
    "./services/script-object-adapter": {
      "import": "./dist/services/script-object-adapter.js"
    },
