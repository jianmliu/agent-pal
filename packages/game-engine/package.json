  "scripts": {
    "build": "node build.mjs"
  },
  "dependencies": {
    "@latticexyz/recs": "^2.2.23",
    "@onchainpal/pal-formats": "workspace:*",
    "jquery": "^3.7.1",
    "opencc-js": "^1.0.5",
    "rxjs": "^7.8.2",
    "sprintf-js": "^1.1.3",
    "@onchainpal/palkit": "workspace:*",
    "@onchainpal/shared": "workspace:*",
    "viem": "^2.51.3"
  },
  "devDependencies": {
    "@types/node": "^22.8.4",
    "@types/sprintf-js": "^1.1.4",
    "esbuild": "^0.28.0"
  }
